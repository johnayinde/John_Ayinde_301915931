erDiagram
    GUESTS ||--o{ BOOKINGS : makes
    BOOKINGS ||--|{ BOOKING_ROOMS : includes
    ROOMS ||--o{ BOOKING_ROOMS : assigned_to
    ROOM_TYPES ||--o{ ROOMS : categorises
    BOOKINGS ||--o{ PAYMENTS : has

    GUESTS {
        bigint guest_id PK
        varchar first_name
        varchar last_name
        varchar email UK
        varchar phone
        timestamptz created_at
    }
    ROOM_TYPES {
        bigint room_type_id PK
        varchar type_name UK
        text description
        smallint max_occupancy
        numeric base_rate
    }
    ROOMS {
        bigint room_id PK
        varchar room_number UK
        bigint room_type_id FK
        smallint floor_number
        varchar operational_status
    }
    BOOKINGS {
        bigint booking_id PK
        varchar booking_reference UK
        bigint guest_id FK
        timestamptz booked_at
        varchar booking_status
        text special_requests
    }
    BOOKING_ROOMS {
        bigint booking_room_id PK
        bigint booking_id FK
        bigint room_id FK
        date check_in
        date check_out
        numeric nightly_rate
        varchar reservation_status
    }
    PAYMENTS {
        bigint payment_id PK
        bigint booking_id FK
        varchar payment_reference UK
        numeric amount
        char currency
        varchar payment_method
        varchar payment_status
        timestamptz paid_at
        timestamptz created_at
    }
